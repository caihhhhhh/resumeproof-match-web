# Server-side only. Never expose this value in client code.
# Public HTTPS origin used for canonical social-preview URLs after deployment.
SITE_URL=https://your-domain.example
# Optional. Add only after a valid mainland China ICP filing is issued.
# NEXT_PUBLIC_ICP_NUMBER=粤ICP备XXXXXXXX号

# Optional GA4 web data stream ID. Public by design; never put a GA API secret here.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-side administrator allowlist. Use lowercase emails separated by commas.
ADMIN_EMAILS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional. The official OpenAI-compatible endpoint is used by default.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional pricing overrides in USD per one million tokens. Defaults follow the
# DeepSeek v4 Flash public pricing checked on 2026-08-28.
# DEEPSEEK_INPUT_CACHE_HIT_PEAK_USD_PER_MTOK=0.014
# DEEPSEEK_INPUT_CACHE_HIT_OFFPEAK_USD_PER_MTOK=0.007
# DEEPSEEK_INPUT_CACHE_MISS_PEAK_USD_PER_MTOK=0.44
# DEEPSEEK_INPUT_CACHE_MISS_OFFPEAK_USD_PER_MTOK=0.22
# DEEPSEEK_OUTPUT_PEAK_USD_PER_MTOK=1.32
# DEEPSEEK_OUTPUT_OFFPEAK_USD_PER_MTOK=0.66

# Server-side visual reading for scanned PDFs and images.
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
